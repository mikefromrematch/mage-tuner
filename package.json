{
  "name": "mage-tuner",
  "version": "0.1.0",
  "description": "MAGE Attuner \u2014 guitar tuner with a transparent, always-on-top desktop mode",
  "main": "main.js",
  "author": "mikefromrematch",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --publish never"
  },
  "devDependencies": {
    "electron": "^37.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.mikefromrematch.magetuner",
    "productName": "MAGE Attuner",
    "files": [
      "index.html",
      "main.js",
      "preload.js",
      "package.json"
    ],
    "mac": {
      "target": "dmg",
      "category": "public.app-category.music",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "MAGE Attuner listens to your instrument to tune it."
      },
      "identity": null,
      "icon": "build/icon.icns"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icon.png"
    },
    "afterPack": "build/adhoc-sign.js"
  }
}
